{
	"name": "pocketchest",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:worker": "wrangler dev",
		"build": "vite build",
		"preview": "npm run build && wrangler dev",
		"deploy": "npm run build && node scripts/deploy.mjs",
		"deploy:code": "npm run build && wrangler deploy --keep-vars",
		"test": "npm run test:unit && npm run test:worker && npm run test:contracts",
		"test:unit": "vitest run test/web test/i18n-keys.spec.ts",
		"test:worker": "vitest run --exclude 'test/web/**' --exclude 'test/contracts/**' --exclude 'test/i18n-keys.spec.ts'",
		"test:contracts": "vitest run test/contracts",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p test/web/tsconfig.json && tsc --noEmit -p test/e2e/tsconfig.json",
		"cf-typegen": "wrangler types",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test:e2e": "playwright test",
		"screenshots": "node scripts/capture-screenshots.mjs",
		"setup:local": "node scripts/setup-local.mjs",
		"check:legacy": "node scripts/check-legacy.mjs",
		"audit:high": "npm audit --audit-level=high"
	},
	"dependencies": {
		"@simplewebauthn/browser": "14.0.0",
		"@simplewebauthn/server": "14.0.3",
		"qrcode-generator": "2.0.4",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.4.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript-eslint/eslint-plugin": "^8.71.1",
		"@typescript-eslint/parser": "^8.71.1",
		"@vitejs/plugin-react": "^6.1.2",
		"eslint": "^10.12.0",
		"jsqr": "1.4.0",
		"prettier": "^3.9.9",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.3",
		"wrangler": "^4.149.0"
	},
	"engines": {
		"node": "^22.12.0 || ^24.0.0 || >=26.0.0"
	},
	"cloudflare": {
		"bindings": {
			"ADMIN_BOOTSTRAP_PASSWORD": {
				"description": "Your PocketChest Owner password (16+ characters). Set it once here; the site only asks you to sign in with it. Nothing else to generate."
			}
		}
	}
}
