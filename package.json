{
	"name": "pocketchest",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:worker": "wrangler dev",
		"build": "vite build",
		"preview": "npm run build && wrangler dev",
		"deploy": "npm run build && wrangler deploy",
		"test": "vitest run",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p test/web/tsconfig.json && tsc --noEmit -p test/e2e/tsconfig.json",
		"cf-typegen": "wrangler types",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.4.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript-eslint/eslint-plugin": "^8.71.1",
		"@typescript-eslint/parser": "^8.71.1",
		"@vitejs/plugin-react": "^6.1.2",
		"eslint": "^10.12.0",
		"prettier": "^3.9.9",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.3",
		"wrangler": "^4.149.0"
	},
	"engines": {
		"node": "^22.12.0 || ^24.0.0 || >=26.0.0"
	}
}
