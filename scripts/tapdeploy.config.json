{
	"$schema": "https://raw.githubusercontent.com/lpyedge/TapDeploy/main/schemas/tapdeploy.config.v3.schema.json",
	"schemaVersion": 3,
	"app": {
		"id": "lpyedge/PocketChest",
		"name": "PocketChest",
		"description": "Private, self-hosted sharing for files and text. One Worker, one R2 bucket, no database."
	},
	"source": {
		"defaultUrl": "https://github.com/lpyedge/PocketChest/releases/latest/download/pocketchest-tapdeploy.zip"
	},
	"capabilities": ["workers", "r2"],
	"resources": [{ "kind": "r2", "name": "pocket-chest" }],
	"inputs": [
		{
			"key": "OWNER_SETUP_PASSWORD",
			"description": "The first owner password. Leave empty and the app generates one: read it from the private R2 object auth/initial-owner-password.txt after install, then change it in Security settings.",
			"label": "Owner password",
			"required": false,
			"type": "secret",
			"upgradeKeep": true,
			"validation": { "minLength": 8 }
		}
	],
	"install": {
		"policies": [
			{
				"kind": "private-r2-owner-bootstrap/v1",
				"unitId": "main",
				"r2Binding": "R2_STORAGE",
				"rootSecret": "JWT_SECRET",
				"armSecret": "SETUP_ARMED",
				"armValue": "yes",
				"ownerKey": "auth/owner.json",
				"markerKey": "auth/bootstrap-marker",
				"initialPasswordKey": "auth/initial-owner-password.txt",
				"readinessPath": "/api/auth/methods"
			}
		]
	}
}
