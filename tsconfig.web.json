{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["dom", "dom.iterable", "es2022"],
		"jsx": "react-jsx",
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["vite/client"],
		"paths": {
			"@/*": ["./src/web/shared/*"]
		}
	},
	"include": ["src/web/**/*.ts", "src/web/**/*.tsx"]
}
