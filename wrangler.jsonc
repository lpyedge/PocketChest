/**
 * PocketChest — one Worker serving both the API (/api/*) and the static frontend (dist/).
 * All data lives in the R2 bucket; there is no database.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pocket-chest",
	"main": "src/worker/index.ts",
	"compatibility_date": "2025-08-13",
	"observability": {
		"enabled": true,
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page",
		"run_worker_first": ["/api/*"],
	},
	"r2_buckets": [
		{
			"bucket_name": "pocket-chest",
			"binding": "R2_STORAGE",
		},
	],
	"vars": {
		"BOOTSTRAP_ENABLED": "false",
	},
	// Uncomment and configure for custom domain:
	// "routes": [
	// 	{
	// 		"pattern": "share.yourdomain.com",
	// 		"custom_domain": true
	// 	}
	// ],
	"workers_dev": true,
	// Hourly cleanup of expired chests and abandoned upload sessions
	"triggers": {
		"crons": ["0 * * * *"],
	},
}
